<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AppManagermentRestaurant.Views.Pages.InvoiceManagementPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:AppManagermentRestaurant.Controls"
    BackgroundColor="White"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <controls:AppHeaderView />

        <Grid Grid.Row="1" Padding="24" RowDefinitions="Auto,Auto,*" RowSpacing="16">
            <Label Grid.Row="0" Text="Quản lý hóa đơn" Style="{StaticResource PageTitle}" />

            <Grid Grid.Row="1" ColumnDefinitions="1.1*,*,*,*,1.2*" ColumnSpacing="10">
                <Border Style="{StaticResource InputBorder}" Padding="10,0" HeightRequest="48">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Text="🔍" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Placeholder="Tìm mã hóa đơn"
                               TextChanged="OnSearchTextChanged" FontSize="13" />
                    </Grid>
                </Border>
                <controls:SearchableDropdownView x:Name="TableFilter" Grid.Column="1"
                                                 Placeholder="Số bàn" SelectionChanged="OnFilterChanged" />
                <controls:SearchableDropdownView x:Name="StaffFilter" Grid.Column="2"
                                                 Placeholder="Nhân viên" SelectionChanged="OnFilterChanged" />
                <controls:SearchableDropdownView x:Name="PaymentFilter" Grid.Column="3"
                                                 Placeholder="Thanh toán" SelectionChanged="OnFilterChanged" />
                <controls:SearchableDropdownView x:Name="ValueSortFilter" Grid.Column="4"
                                                 Placeholder="Sắp xếp theo Trị giá" SelectionChanged="OnFilterChanged" />
                </Grid>

            <CollectionView Grid.Row="2" ItemsSource="{Binding FilteredInvoices}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="Không tìm thấy hóa đơn phù hợp." TextColor="{StaticResource TextMuted}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <VerticalStackLayout Spacing="7">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding TableNumber, StringFormat='Bàn {0}'}" FontAttributes="Bold" FontSize="16" />
                                        <Label Text="{Binding Id, StringFormat='• Hóa đơn #{0}'}" Style="{StaticResource SecondaryTextStyle}" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding ServerName, StringFormat='Nhân viên: {0}'}" Style="{StaticResource SecondaryTextStyle}" />
                                    <Label Text="{Binding CreatedAtDisplay}" Style="{StaticResource SecondaryTextStyle}" />
                                    <Label Text="{Binding PaymentMethodDisplay}" Style="{StaticResource MutedTextStyle}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="10" HorizontalOptions="End">
                                    <Label Text="{Binding TotalDisplay}" FontAttributes="Bold" FontSize="17"
                                           TextColor="{StaticResource Primary}" HorizontalOptions="End" />
                                    <HorizontalStackLayout Spacing="8">
                                        <Button Text="Xem chi tiết" Style="{StaticResource SecondaryButton}"
                                                CommandParameter="{Binding .}" Clicked="OnViewInvoiceClicked" />
                                        <Button Text="Mở bản in" Style="{StaticResource PrimaryButton}"
                                                CommandParameter="{Binding .}" Clicked="OnPrintInvoiceClicked" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Grid x:Name="InvoiceDetailModal" Grid.RowSpan="2" IsVisible="False" BackgroundColor="#80000000">
            <Border Style="{StaticResource ModalBorder}" WidthRequest="520" MaximumHeightRequest="680"
                    HorizontalOptions="Center" VerticalOptions="Center">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="{Binding SelectedInvoice.Id, StringFormat='Hóa đơn #{0}'}" Style="{StaticResource SectionTitle}" FontSize="20" />
                            <Label Text="{Binding SelectedInvoice.TableNumber, StringFormat='Bàn {0}'}" Style="{StaticResource SecondaryTextStyle}" />
                            <Label Text="{Binding SelectedInvoice.CreatedAtDisplay}" Style="{StaticResource MutedTextStyle}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Đóng" Style="{StaticResource SecondaryButton}" Clicked="OnCloseDetailClicked" />
                    </Grid>
                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Spacing="9" BindableLayout.ItemsSource="{Binding SelectedInvoice.Items}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Name}" FontAttributes="Bold" />
                                            <Label Text="{Binding Quantity, StringFormat='Số lượng: {0}'}" Style="{StaticResource SecondaryTextStyle}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding LineTotalDisplay}" FontAttributes="Bold" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>
                    <VerticalStackLayout Grid.Row="2" Spacing="8">
                        <BoxView HeightRequest="1" Color="{StaticResource BorderLight}" />
                        <Grid ColumnDefinitions="*,Auto"><Label Text="Tạm tính" /><Label Grid.Column="1" Text="{Binding SelectedInvoice.SubtotalDisplay}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><Label Text="Giảm giá" /><Label Grid.Column="1" Text="{Binding SelectedInvoice.DiscountDisplay}" TextColor="{StaticResource Danger}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><Label Text="Tổng cộng" FontAttributes="Bold" FontSize="16" /><Label Grid.Column="1" Text="{Binding SelectedInvoice.TotalDisplay}" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource Primary}" /></Grid>
                        <Button Text="Mở bản in" Style="{StaticResource PrimaryButton}" Clicked="OnPrintSelectedClicked" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
