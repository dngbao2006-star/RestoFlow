<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    x:Class="AppManagermentRestaurant.Views.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="White"
    Shell.NavBarIsVisible="False">

    <Grid ColumnDefinitions="*,*">

        <Grid Grid.ColumnSpan="2" 
              IsVisible="{Binding IsLoading}" 
              BackgroundColor="#CC000000"
              ZIndex="100">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsLoading}" Color="White" Scale="2" />
                <Label Text="Đang đăng nhập..." TextColor="White" FontSize="14" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Column="0" IsVisible="{OnIdiom Phone=False, Default=True}">
            <Image Source="anhnenlogin.jpg" Aspect="AspectFill"/>
            <!-- Gradient overlay: tối dần từ dưới lên để chữ trắng dễ đọc -->
            <BoxView>
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#331B3A6B" Offset="0"/>
                        <GradientStop Color="#22000000" Offset="0.4"/>
                        <GradientStop Color="#99000000" Offset="1"/>
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <!-- Tên nhà hàng ở góc trên cùng bên trái -->
            <HorizontalStackLayout Spacing="10" Padding="30,30,0,0" VerticalOptions="Start" HorizontalOptions="Start">
                <Border Background="White" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10,6">
                    <Label Text="🍽️" FontSize="16" VerticalOptions="Center" HorizontalOptions="Center"/>
                </Border>
                <Label Text="The Golden Plate" FontSize="22" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <!-- Tagline ở phần giữa-dưới -->
            <VerticalStackLayout Padding="40" Spacing="16" VerticalOptions="End" Margin="0,0,0,60">
                <HorizontalStackLayout Spacing="10">
                    <Border Background="White" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="10,5">
                        <Label Text="Chef" TextColor="#1B3A6B" FontAttributes="Bold"/>
                    </Border>
                    <Label Text="Nhà hàng đẳng cấp" FontSize="22" FontAttributes="Bold" TextColor="White"/>
                </HorizontalStackLayout>
                <Label Text="Nâng tầm mọi trải nghiệm ẩm thực" FontSize="34" FontAttributes="Bold" TextColor="White" LineBreakMode="WordWrap"/>
                <Label Text="Hệ thống quản lý nhà hàng thông minh và hiện đại" FontSize="15" TextColor="#E9EEF8"/>
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Column="1" BackgroundColor="White">
            <ScrollView>
                <VerticalStackLayout Padding="48,60" Spacing="24" VerticalOptions="Center" MaximumWidthRequest="440">
                    <Label Text="Chào mừng quay trở lại" FontSize="28" FontAttributes="Bold" TextColor="#1B3A6B"/>

                    <!-- Email input -->
                    <Border x:Name="EmailBorder" Stroke="#DDD" StrokeShape="RoundRectangle 12" Padding="12">
                        <Grid ColumnDefinitions="Auto,*">
                            <Label x:Name="EmailIcon" Text="✉" TextColor="#9CA3AF" FontSize="18" VerticalOptions="Center"/>
                            <Entry Grid.Column="1" Text="{Binding Email}" Placeholder="Địa chỉ email" 
                                   IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanNegationConverter}}"
                                   Focused="OnEmailEntryFocused" Unfocused="OnEmailEntryUnfocused"/>
                        </Grid>
                    </Border>

                    <!-- Password input -->
                    <Border x:Name="PasswordBorder" Stroke="#DDD" StrokeShape="RoundRectangle 12" Padding="12">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label x:Name="PasswordIcon" Text="🔒" TextColor="#9CA3AF" FontSize="18" VerticalOptions="Center"/>
                            <Entry x:Name="PasswordEntry" Grid.Column="1" Text="{Binding Password}" Placeholder="Mật khẩu" 
                                   IsPassword="True" ReturnType="Done" Completed="OnPasswordCompleted" 
                                   IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanNegationConverter}}"
                                   Focused="OnPasswordEntryFocused" Unfocused="OnPasswordEntryUnfocused"/>
                            <ImageButton x:Name="EyeButton" Grid.Column="2" Source="eye_open.png" 
                                         WidthRequest="28" HeightRequest="28" BackgroundColor="Transparent" 
                                         Padding="2" VerticalOptions="Center" Clicked="OnTogglePasswordClicked"/>
                        </Grid>
                    </Border>

                    <Label Text="{Binding ErrorMessage}" TextColor="#EF4444" FontSize="13" 
                           IsVisible="{Binding HasError}" Margin="0,-10,0,0"/>

                    <!-- Quên mật khẩu: sát nút đăng nhập, căn lề phải -->
                    <Button Text="Quên mật khẩu?" BackgroundColor="Transparent" TextColor="#1B3A6B" 
                            FontAttributes="Bold" FontSize="13" HorizontalOptions="End" 
                            Padding="0" Margin="0,-10,0,-10"
                            Command="{Binding ForgotPasswordCommand}"/>

                    <Button Text="Đăng nhập" BackgroundColor="#1B3A6B" TextColor="White" CornerRadius="12" 
                            HeightRequest="50" FontAttributes="Bold"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanNegationConverter}}" 
                            Command="{Binding SignInCommand}"/>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>