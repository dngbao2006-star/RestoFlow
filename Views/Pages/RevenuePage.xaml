<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AppManagermentRestaurant.Views.Pages.RevenuePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:AppManagermentRestaurant.Controls"
    BackgroundColor="White"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <controls:AppHeaderView />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="20">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Doanh thu &amp; Báo cáo" Style="{StaticResource PageTitle}" />
                        <Label Text="{Binding PeriodLabel, StringFormat='Số liệu: {0}'}" Style="{StaticResource SecondaryTextStyle}" />
                    </VerticalStackLayout>
                    <HorizontalStackLayout Grid.Column="1" Spacing="8">
                        <Button Text="Chia sẻ báo cáo" Style="{StaticResource SecondaryButton}" Command="{Binding ExportTextCommand}" />
                        <Button Text="Chia sẻ CSV" Style="{StaticResource SecondaryButton}" Command="{Binding ExportCsvCommand}" />
                        <Button Text="Lưu báo cáo" Style="{StaticResource PrimaryButton}" Command="{Binding SaveTextCommand}" />
                        <Button Text="Lưu CSV" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCsvCommand}" />
                    </HorizontalStackLayout>
                </Grid>

                <HorizontalStackLayout Spacing="8">
                    <Button x:Name="BtnToday" Text="Hôm nay" Style="{StaticResource PillButton}" Clicked="OnPeriodFilterClicked" CommandParameter="today" />
                    <Button x:Name="BtnWeek" Text="Tuần này" Style="{StaticResource PillButton}" BackgroundColor="#F5F0E8" Clicked="OnPeriodFilterClicked" CommandParameter="week" />
                    <Button x:Name="BtnMonth" Text="Tháng này" Style="{StaticResource PillButton}" Clicked="OnPeriodFilterClicked" CommandParameter="month" />
                    <Button x:Name="BtnYear" Text="Cả năm" Style="{StaticResource PillButton}" Clicked="OnPeriodFilterClicked" CommandParameter="year" />
                </HorizontalStackLayout>

                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12">
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Doanh thu" FontAttributes="Bold" />
                            <Label Text="{Binding NetRevenueDisplay}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Label Text="{Binding GrossRevenueDisplay, StringFormat='Trước giảm giá: {0}'}" Style="{StaticResource MutedTextStyle}" FontSize="10" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="So với kỳ trước" FontAttributes="Bold" />
                            <Label Text="{Binding ComparisonDisplay}" FontSize="22" FontAttributes="Bold" TextColor="{Binding ComparisonColor}" />
                            <Label Text="Cùng độ dài kỳ" Style="{StaticResource MutedTextStyle}" FontSize="10" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Tổng hóa đơn" FontAttributes="Bold" />
                            <Label Text="{Binding TotalOrdersCount}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Warning}" />
                            <Label Text="Đã thanh toán" Style="{StaticResource MutedTextStyle}" FontSize="10" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Giá trị TB/đơn" FontAttributes="Bold" />
                            <Label Text="{Binding AverageOrderDisplay}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Success}" />
                            <Label Text="Theo doanh thu" Style="{StaticResource MutedTextStyle}" FontSize="10" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Tổng giảm giá" FontAttributes="Bold" />
                            <Label Text="{Binding DiscountDisplay}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Danger}" />
                            <Label Text="Trong kỳ đã chọn" Style="{StaticResource MutedTextStyle}" FontSize="10" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="1.3*,0.7*" ColumnSpacing="12">
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Biểu đồ doanh thu" Style="{StaticResource SectionTitle}" FontSize="20" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding ChartItems}" Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="50,*,Auto" ColumnSpacing="8" Padding="0,2">
                                            <Label Text="{Binding Label}" Style="{StaticResource SecondaryTextStyle}" FontSize="11" VerticalOptions="Center" />
                                            <Grid Grid.Column="1">
                                                <BoxView Color="{StaticResource PrimaryAccent}" HeightRequest="18" CornerRadius="4"
                                                         HorizontalOptions="Start" WidthRequest="{Binding BarWidthFraction}" Opacity="0.8" />
                                            </Grid>
                                            <Label Grid.Column="2" Text="{Binding ValueDisplay}" FontAttributes="Bold" FontSize="11" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="12">
                        <Border Style="{StaticResource CardBorder}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Phương thức thanh toán" Style="{StaticResource SectionTitle}" FontSize="18" />
                                <Grid ColumnDefinitions="*,Auto"><Label Text="Tiền mặt" /><Label Grid.Column="1" Text="{Binding CashRevenueDisplay}" FontAttributes="Bold" /></Grid>
                                <Grid ColumnDefinitions="*,Auto"><Label Text="QR chuyển khoản" /><Label Grid.Column="1" Text="{Binding QrRevenueDisplay}" FontAttributes="Bold" /></Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Món có doanh thu cao nhất" Style="{StaticResource SectionTitle}" FontSize="18" />
                                <Label Text="Chưa có dữ liệu món trong kỳ." IsVisible="{Binding HasNoTopDishes}" Style="{StaticResource MutedTextStyle}" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding TopDishes}" Spacing="7">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="12" />
                                                <Label Grid.Column="1" Text="{Binding RevenueDisplay}" FontAttributes="Bold" FontSize="12" />
                                                <ProgressBar Grid.Row="1" Progress="{Binding Share}" ProgressColor="{StaticResource PrimaryAccent}" />
                                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding ShareDisplay}" FontSize="10" TextColor="{StaticResource Primary}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Món bán chạy nhất" Style="{StaticResource SectionTitle}" FontSize="18" />
                                <Label Text="Chưa có dữ liệu món trong kỳ." IsVisible="{Binding HasNoTopSellingDishes}" Style="{StaticResource MutedTextStyle}" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding TopSellingDishes}" Spacing="7">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="12" />
                                                <Label Grid.Column="1" Text="{Binding Quantity, StringFormat='{0} phần'}" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource Primary}" />
                                                <ProgressBar Grid.Row="1" Progress="{Binding Share}" ProgressColor="{StaticResource Success}" />
                                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding RevenueDisplay}" FontSize="10" TextColor="{StaticResource Primary}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
