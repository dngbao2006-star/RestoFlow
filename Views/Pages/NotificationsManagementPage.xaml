<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AppManagermentRestaurant.Views.Pages.NotificationsManagementPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:AppManagermentRestaurant.Controls"
    BackgroundColor="White"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,*" ColumnSpacing="20">
        <controls:AppHeaderView Grid.ColumnSpan="2" />

        <ScrollView Grid.Row="1" Grid.Column="0">
            <VerticalStackLayout Padding="24" Spacing="20">
                <Label Text="Gửi thông báo" Style="{StaticResource PageTitle}" />

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Text="Nội dung thông báo" FontAttributes="Bold" VerticalOptions="Center" />
                            <Button x:Name="ImportantToggleButton" Grid.Column="1" Text="Quan trọng"
                                    Style="{StaticResource PillButton}" Clicked="OnImportantClicked" />
                        </Grid>

                        <Border Style="{StaticResource InputBorder}">
                            <Entry x:Name="TitleEntry" Placeholder="Tiêu đề" MaxLength="100" />
                        </Border>

                        <Border Style="{StaticResource InputBorder}">
                            <Editor x:Name="MessageEditor" Placeholder="Nội dung thông báo" AutoSize="TextChanges"
                                    MaxLength="500" MinimumHeightRequest="110" />
                        </Border>

                        <Label x:Name="ValidationLabel" IsVisible="False" TextColor="{StaticResource Danger}" FontSize="12" />
                        <Button x:Name="SendButton" Text="Gửi thông báo"
                                Style="{StaticResource PrimaryButton}" Clicked="OnSendClicked" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" Grid.Column="1" Padding="24" RowDefinitions="Auto,*" RowSpacing="20">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Thông báo gần đây" Style="{StaticResource PageTitle}" />
                <Label Grid.Column="1" Text="{Binding RecentNotifications.Count, StringFormat='{0} thông báo'}"
                       Style="{StaticResource SecondaryTextStyle}" VerticalOptions="Center" />
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                <CollectionView ItemsSource="{Binding RecentNotifications}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="Chưa có thông báo nào." TextColor="{StaticResource TextMuted}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource InputBorder}" Padding="12" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Border Background="{Binding TypeColor}" Stroke="Transparent" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10" Padding="7" VerticalOptions="Start">
                                        <Label Text="{Binding ImportanceLabel}" TextColor="White" FontSize="10" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label Text="{Binding Title}" FontAttributes="Bold" />
                                        <Label Text="{Binding Message}" Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
                                        <Label Text="{Binding TimestampDisplay}" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="2" Text="Xóa" Style="{StaticResource DangerButton}"
                                            Padding="10,6" VerticalOptions="Start" CommandParameter="{Binding .}"
                                            Clicked="OnDeleteClicked" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
