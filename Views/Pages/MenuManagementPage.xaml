<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AppManagermentRestaurant.Views.Pages.MenuManagementPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:AppManagermentRestaurant.Controls"
    BackgroundColor="White"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <controls:AppHeaderView />

        <Grid Grid.Row="1" Padding="24" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="20">
                <HorizontalStackLayout Grid.Row="0" Spacing="12" VerticalOptions="Center">
                    <Label Text="Quản lý thực đơn" Style="{StaticResource PageTitle}" />
                    <Button 
                        Text="Thêm món" 
                        Style="{StaticResource PrimaryButton}" 
                        Clicked="OnAddMenuItemClicked" />
                </HorizontalStackLayout>

                <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Tổng số món" FontAttributes="Bold" />
                            <Label Text="{Binding TotalMenuItemCount}" FontSize="22" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Grid.Column="1">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Đang phục vụ" FontAttributes="Bold" />
                            <Label Text="{Binding AvailableMenuItemCount}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Success}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Grid.Column="2">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Hết món" FontAttributes="Bold" />
                            <Label Text="{Binding OutOfStockMenuItemCount}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Danger}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Border Style="{StaticResource InputBorder}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Text="Tìm kiếm" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                                <Entry Grid.Column="1" Placeholder="Tìm món ăn" TextChanged="OnSearchTextChanged" />
                            </Grid>
                        </Border>
                        <ScrollView Orientation="Horizontal">
                            <HorizontalStackLayout Spacing="8">
                                <Button Text="Tất cả" Style="{StaticResource PillButton}" Clicked="OnCategoryFilterClicked" CommandParameter="All" />
                                <Button Text="Khai vị" Style="{StaticResource PillButton}" Clicked="OnCategoryFilterClicked" CommandParameter="Appetizers" />
                                <Button Text="Món chính" Style="{StaticResource PillButton}" Clicked="OnCategoryFilterClicked" CommandParameter="Main Course" />
                                <Button Text="Canh/Súp" Style="{StaticResource PillButton}" Clicked="OnCategoryFilterClicked" CommandParameter="Soups" />
                                <Button Text="Hải sản" Style="{StaticResource PillButton}" Clicked="OnCategoryFilterClicked" CommandParameter="Seafood" />
                                <Button Text="Tráng miệng" Style="{StaticResource PillButton}" Clicked="OnCategoryFilterClicked" CommandParameter="Desserts" />
                                <Button Text="Đồ uống" Style="{StaticResource PillButton}" Clicked="OnCategoryFilterClicked" CommandParameter="Drinks" />
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

                <CollectionView Grid.Row="3" ItemsSource="{Binding FilteredMenuItems}" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="3" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,12,12">
                                <VerticalStackLayout Spacing="8">
                                    <Grid HeightRequest="160">
                                        <Image Source="{Binding Image}" Aspect="AspectFill" />
                                        <Border Background="#99000000" Stroke="#00000000" StrokeThickness="0" IsVisible="{Binding OutOfStock}">
                                            <Label Text="HẾT MÓN" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                    </Grid>
                                    <Label Text="{Binding Name}" FontAttributes="Bold" />
                                    <Label Text="{Binding Description}" Style="{StaticResource SecondaryTextStyle}" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Price, StringFormat='{0:0,0} VND'}" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                    <HorizontalStackLayout Spacing="8">
                                        <Button 
                                            Text="Sửa" 
                                            Style="{StaticResource SecondaryButton}"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnEditMenuItemClicked" />
                                        <Button 
                                            Text="Xóa" 
                                            Style="{StaticResource DangerButton}"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnDeleteMenuItemClicked" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
