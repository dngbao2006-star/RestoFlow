<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="AppManagermentRestaurant.Controls.Popups.NotificationPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Color="Transparent"
    CanBeDismissedByTappingOutsideOfPopup="True">

    <Border BackgroundColor="#FDFAF6"
            Stroke="#E7DECF"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 16"
            Padding="0"
            WidthRequest="360"
            MaximumHeightRequest="520"
            Shadow="{Shadow Brush=Black, Offset='0,8', Radius=20, Opacity=0.18}">

        <Grid RowDefinitions="Auto,*">
            <Grid Padding="16" RowDefinitions="Auto,Auto" RowSpacing="10">
                <Label Text="Thông báo"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#1A1209" />
                <BoxView Grid.Row="1" HeightRequest="1" Color="#EFE4D5" />
            </Grid>

            <ScrollView Grid.Row="1" MaximumHeightRequest="450">
                <VerticalStackLayout Spacing="12" Padding="12,0,12,12">

                    <!-- Khu quan trọng luôn nằm trên cùng. -->
                    <Border BackgroundColor="#FFF1F2"
                            Stroke="#FCA5A5"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="12">
                        <VerticalStackLayout Spacing="9">
                            <Grid ColumnDefinitions="*,Auto">
                                <HorizontalStackLayout Spacing="7">
                                    <Label Text="!" TextColor="#DC2626" FontAttributes="Bold" />
                                    <Label Text="Thông báo quan trọng"
                                           TextColor="#991B1B"
                                           FontAttributes="Bold"
                                           FontSize="13" />
                                </HorizontalStackLayout>
                                <Label Grid.Column="1" Text="{Binding ImportantNotifications.Count}"
                                       TextColor="#B91C1C" FontSize="12" />
                            </Grid>

                            <Label Text="Không có thông báo quan trọng."
                                   IsVisible="{Binding HasNoImportantNotifications}"
                                   TextColor="#B98A8A" FontSize="12" />

                            <VerticalStackLayout Spacing="8"
                                                 BindableLayout.ItemsSource="{Binding ImportantNotifications}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="White"
                                                Stroke="#FECACA"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 10"
                                                Padding="10">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                <Border WidthRequest="28" HeightRequest="28"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 14"
                                                        BackgroundColor="{Binding IconBackgroundColor}">
                                                    <Label Text="{Binding IconGlyph}"
                                                           TextColor="{Binding IconColor}"
                                                           FontAttributes="Bold"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                                    <Label Text="{Binding Title}" FontSize="13"
                                                           FontAttributes="Bold" TextColor="#7F1D1D" />
                                                    <Label Text="{Binding Message}" FontSize="12"
                                                           TextColor="#7B4B4B" LineHeight="1.35" />
                                                    <Label Text="{Binding TimestampDisplay}" FontSize="10"
                                                           TextColor="#B98A8A" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Thông báo thường chỉ xuất hiện sau toàn bộ thông báo quan trọng. -->
                    <Grid ColumnDefinitions="*,Auto" Padding="4,2,4,0">
                        <Label Text="Thông báo khác" FontSize="13"
                               FontAttributes="Bold" TextColor="#1A1209" />
                        <Label Grid.Column="1" Text="{Binding NormalNotifications.Count}"
                               TextColor="#9A8875" FontSize="12" />
                    </Grid>

                    <Label Text="Chưa có thông báo nào khác."
                           IsVisible="{Binding HasNoNormalNotifications}"
                           TextColor="#B7A99A" FontSize="12" Padding="4,0" />

                    <VerticalStackLayout Spacing="0"
                                         BindableLayout.ItemsSource="{Binding NormalNotifications}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid RowDefinitions="Auto,Auto">
                                    <Border Padding="10,10"
                                            BackgroundColor="{Binding RowBackgroundColor}"
                                            StrokeThickness="0">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Border WidthRequest="28" HeightRequest="28"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 14"
                                                    BackgroundColor="{Binding IconBackgroundColor}">
                                                <Label Text="{Binding IconGlyph}" FontSize="13"
                                                       TextColor="{Binding IconColor}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                                <Label Text="{Binding Title}" FontSize="13"
                                                       FontAttributes="Bold" TextColor="#1A1209" />
                                                <Label Text="{Binding Message}" FontSize="12"
                                                       TextColor="#7B6A57" LineHeight="1.35" />
                                                <Label Text="{Binding TimestampDisplay}" FontSize="10"
                                                       TextColor="#B7A99A" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                    <BoxView Grid.Row="1" HeightRequest="1" Color="#EFE4D5" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Border>
</toolkit:Popup>
